  "usage_in_pipeline": {
    "link_key": "SK_ID_CURR",
    "target_table": "application_train.csv / application_test.csv",
    "aggregation_strategy": "Группировка по SK_ID_CURR с вычислением агрегатов: count, nunique, mean, median, std, min, max по числовым; mode, value_counts по категориальным",
    "key_numeric_for_agg": [
      "AMT_ANNUITY", "AMT_APPLICATION", "AMT_CREDIT", "AMT_DOWN_PAYMENT",
      "AMT_GOODS_PRICE", "DAYS_DECISION", "CNT_PAYMENT", "SELLERPLACE_AREA",
      "DAYS_FIRST_DRAWING", "DAYS_FIRST_DUE", "DAYS_LAST_DUE"
    ],
    "key_categorical_for_agg": [
      "NAME_CONTRACT_TYPE", "NAME_CONTRACT_STATUS", "CODE_REJECT_REASON",
      "NAME_CLIENT_TYPE", "NAME_PORTFOLIO", "NAME_PRODUCT_TYPE",
      "CHANNEL_TYPE", "NAME_YIELD_GROUP", "NAME_PAYMENT_TYPE"
    ],
    "columns_to_skip": [
      "RATE_INTEREST_PRIMARY", "RATE_INTEREST_PRIVILEGED"
    ],
    "columns_with_50pct_missing": [
      "RATE_DOWN_PAYMENT", "AMT_DOWN_PAYMENT"
    ]
  }
